local function requestSafely(options)
	local ok, response = pcall(http, options)
	if ok and type(response) == "table" then
		return response
	end
	return nil
end

local function decode(body)
	local ok, value = pcall(function()
		return Http:JSONDecode(body or "")
	end)
	if ok and type(value) == "table" then
		return value
	end
	return nil
end

local function clean(value, limit)
	local text = tostring(value)
		:gsub("[%c]", " ")
		:gsub("`", "'")

	local ok, boundary = pcall(
		utf8.offset, text, (limit or 100) + 1
	)

	if ok and boundary then
		text = text:sub(1, boundary - 1)
	elseif not ok then
		text = text:gsub("[^\032-\126]", "?")
			:sub(1, limit or 100)
	end

	return text
end

local function sendDiscord(message)
	local payload

	if type(message) == "table" then
		payload = message
	else
		payload = {content = tostring(message)}
	end

	payload.username = "🍬 BGSI • Rift Radar"
	payload.allowed_mentions = {parse = {}}

	for attempt = 1, 3 do
		local response = requestSafely({
			Url = CONFIG.Webhook,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = Http:JSONEncode(payload)
		})

		if not response then
			return false, "Network request failed"
		end

		local status = tonumber(response.StatusCode)

		if status and status >= 200 and status < 300 then
			return true
		end

		if status ~= 429 then
			return false, "Discord HTTP " .. tostring(status)
		end

		local data = decode(response.Body)
		local delay = data and tonumber(data.retry_after) or 5
		task.wait(math.max(delay or 5, 1) + 1)
	end

	return false, "Discord remained rate-limited"
end

local function readLabels(rift)
	local labels = {}

	for _, object in ipairs(rift:GetDescendants()) do
		if object:IsA("TextLabel") or object:IsA("TextButton") then
			local text = clean(object.Text, 120)
			if text:match("%S") then
				table.insert(labels, {
					name = object.Name:lower(),
					path = object:GetFullName():lower(),
					text = text
				})
			end
		end
	end

	table.sort(labels, function(a, b)
		return a.path < b.path
	end)

	return labels
end

local function identifyLuck(labels)
	for _, label in ipairs(labels) do
		if label.name:find("luck", 1, true) then
			return label.text
		end
	end

	for _, label in ipairs(labels) do
		if label.text:lower():find("luck", 1, true) then
			return label.text
		end
	end

	return "Not identified in displayed labels"
end

