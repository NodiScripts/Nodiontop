	for _, label in ipairs(labels) do
		local name = label.name
		if name:find("timer", 1, true)
			or name:find("countdown", 1, true)
			or name:find("remaining", 1, true)
			or name:find("expire", 1, true)
			or name == "time"
			or name == "duration" then
			return label.text
		end
	end

	for _, label in ipairs(labels) do
		local text = label.text:lower()
		if text:find("remaining", 1, true)
			or text:find("expires", 1, true)
			or text:find("disappears", 1, true)
			or text:find("time left", 1, true) then
			return label.text
		end
	end

	for _, label in ipairs(labels) do
		if label.text:match("^%s*%d+:%d%d%s*$")
			or label.text:match("^%s*%d+:%d%d:%d%d%s*$") then
			return label.text .. " (clock meaning unverified)"
		end
	end

	return "Not identified in displayed labels"
end

local function buildEmbed(rift, labels, joinUrl)
	local displayName = clean(rift.Name, 80)
		:gsub("%-", " ")
		:gsub("_", " ")

	local embed = {
		title = "🫧 " .. displayName .. " • Rift Spotted!",
		url = joinUrl,
		description =
			"🍬 **Bubble Gum Simulator Infinity**\n"
			.. "A loaded egg / rift entry was detected.\n\n"
			.. "🎮 [**Join this server**](" .. joinUrl .. ")",
		color = 16738740,
		fields = {
			{
				name = "🍀 Luck",
				value = identifyLuck(labels),
				inline = true
			},
			{
				name = "⏳ Displayed time remaining",
				value = identifyTime(labels),
				inline = true
			},
			{
				name = "🥚 Rift / egg entry",
				value = clean(rift.Name, 100),
				inline = false
			},
			{
				name = "🌐 Server ID",
				value = "`" .. game.JobId .. "`",
				inline = false
			}
		},
		footer = {
			text = "🍭 BGSI Rift Radar • Displayed values at scan time"
		},
		timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
	}

	local details, seen, bytes = {}, {}, 0

	for _, label in ipairs(labels) do
		if not seen[label.text] then
			seen[label.text] = true
			local line = "▫️ " .. label.text

			if bytes + #line + 1 > 850 then
				table.insert(details, "…additional labels omitted")
				break
			end

			bytes = bytes + #line + 1
			table.insert(details, line)
		end
	end

	if #details > 0 then
		table.insert(embed.fields, {
			name = "✨ In-game display details",
			value = table.concat(details, "\n"),
			inline = false
		})
	end

	if type(CONFIG.GifUrl) == "string"
		and CONFIG.GifUrl:match("^https://") then
		embed.image = {url = CONFIG.GifUrl}
	end

	return embed
end

local function findNextServer()
	local candidates, candidateIds = {}, {}
	local cursor

	for page = 1, CONFIG.MaxServerPages do
		local url =
			"https://games.roblox.com/v1/games/"
			.. tostring(game.PlaceId)
			.. "/servers/Public?sortOrder=Asc&limit=100"

		if cursor then
			url = url .. "&cursor=" .. Http:UrlEncode(cursor)
		end

		local response = requestSafely({
			Url = url,
			Method = "GET"
		})

		if not response or tonumber(response.StatusCode) ~= 200 then
			return nil, "Public-server listing failed"
		end

		local data = decode(response.Body)
		if not data or type(data.data) ~= "table" then
			return nil, "Invalid public-server response"
		end

		for _, server in ipairs(data.data) do
			if type(server.id) == "string"
				and not visited[server.id]
				and not candidateIds[server.id]
				and type(server.playing) == "number"
				and type(server.maxPlayers) == "number"
				and server.playing < server.maxPlayers then

				candidateIds[server.id] = true
				table.insert(candidates, server.id)
			end
		end

		cursor = data.nextPageCursor
		if #candidates > 0 or not cursor then
			break
		end

		task.wait(2)
	end

	if #candidates == 0 then
		return nil, "No unvisited joinable server in searched pages"
	end

	return candidates[math.random(1, #candidates)]
end

local function main()
