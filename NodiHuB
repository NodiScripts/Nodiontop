	local function rbxHat()
		if hatBusy then
			message("RBX Hat is already running or stopping.")
			return
		end

		local id, present
		for key, data in pairs(Hats) do
			if data[1] == CONFIG.Hat then
				id = key
				present = data[2] == 5 and "Golden"
					or "Tier " .. data[2]
				break
			end
		end
		assert(id, "Unknown hat name.")

		hatBusy, hatRunning = true, true
		local success, err = xpcall(function()
			local r = workspace.__REMOTES
			local slots = r.Core["Get Stats"]:InvokeServer().Save.HatSlots
			local found = false
			message("RBX Hat running...")

			repeat
				task.wait()
				if not alive or not hatRunning then
					break
				end

				local available = slots
					- #r.Core["Get Stats"]:InvokeServer().Save.Hats

				if available <= 0 then
					message("No free hat slots.")
					break
				end

				local toDelete, completed, batchError = {}, 0, nil

				for _ = 1, available do
					task.spawn(function()
						local bought, purchaseError = pcall(function()
							local _, result = r.Game.Shop:InvokeServer(
								"Buy", "Presents", present
							)
							local hat = result
								and result[1] and result[1][1]
							assert(hat, "Unexpected purchase response.")

							if tonumber(hat.n) == id then
								found = true
							else
								table.insert(toDelete, hat.id)
							end
						end)

						if not bought then
							batchError = tostring(purchaseError)
						end
						completed = completed + 1
					end)
				end

				repeat
					task.wait()
				until completed == available

				if #toDelete > 0 then
					r.Game.Hats:InvokeServer("MultiDelete", toDelete)
				end
				if batchError then
					error(batchError)
				end
			until CONFIG.GetOnlyOneHat and found

			if found then
				message("Obtained " .. CONFIG.Hat .. " hat.")
			end
		end, trace)

		hatBusy, hatRunning = false, false
		if not success then
			error(err, 0)
		end
	end

