	local function exportInventory()
		local directory =
			require(game.ReplicatedStorage["1 | Directory"]).Pets
		local stats = workspace.__REMOTES.Core["Get Other Stats"]
			:InvokeServer()

		local report = "Inventory of "
			.. table.concat(CONFIG.ExportAccounts, ", ")
		local total, grouped, sorted = 0, {}, {}

		for _, username in ipairs(CONFIG.ExportAccounts) do
			local account = stats[username]
			assert(account and account.Save and account.Save.Pets,
				"Inventory unavailable for " .. username)

			for _, pet in pairs(account.Save.Pets) do
				local variant = pet.dm and pet.r and "Glitched"
					or pet.dm and "DM"
					or pet.r and "Rainbow"
					or pet.g and "Gold"
					or "Regular"

				local key = pet.n .. "-" .. variant .. "-" .. pet.l
				if not grouped[key] then
					local entry = directory[pet.n]
					grouped[key] = {
						count = 0,
						variant = variant,
						name = entry and entry.DisplayName
							or tostring(pet.n),
						level = pet.l,
					}
				end

				grouped[key].count = grouped[key].count + 1
				total = total + 1
			end
		end

		local function formatNumber(number)
			local text = tostring(number)
			while true do
				local count
				text, count = text:gsub(
					"^(-?%d+)(%d%d%d)", "%1,%2"
				)
				if count == 0 then
					break
				end
			end
			return text
		end

		for _, entry in pairs(grouped) do
			table.insert(sorted, entry)
		end
		table.sort(sorted, function(a, b)
			return tonumber(a.level) > tonumber(b.level)
		end)

		report = report .. "\nTotal: " .. total .. "\n\n"
		for _, entry in ipairs(sorted) do
			report = report .. entry.count .. "x "
				.. entry.variant .. " " .. entry.name
				.. " | " .. formatNumber(entry.level) .. "\n"
		end

		assert(type(setclipboard) == "function",
			"setclipboard is unavailable.")
		setclipboard(report)
		message("Inventory copied to clipboard.")
	end

