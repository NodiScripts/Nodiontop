		return
	end

	local rifts = rendered:WaitForChild("Rifts", 30)
	if not rifts then
		fail("Workspace.Rendered.Rifts did not load.")
		return
	end

	task.wait(CONFIG.SettleSeconds)

	local joinUrl =
		"https://www.roblox.com/games/start?placeId="
		.. tostring(game.PlaceId)
		.. "&gameInstanceId="
		.. Http:UrlEncode(game.JobId)

	local riftList = {}

	for _, rift in ipairs(rifts:GetChildren()) do
		if rift:IsA("Model")
			or rift:IsA("Folder")
			or rift:IsA("BasePart") then
			table.insert(riftList, rift)
		end
	end

	table.sort(riftList, function(a, b)
		return a.Name < b.Name
	end)

	log("Loaded entries: " .. #riftList)

	if #riftList == 0 then
		local sent, reason = sendDiscord({
			embeds = {{
				title = "🫧 BGSI • Rift Scan",
				description =
					"No loaded rift entries found.\n\n"
					.. "🎮 [Join this server](" .. joinUrl .. ")",
				color = 16738740,
				timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
				footer = {text = "🍭 BGSI Rift Radar"}
			}}
		})

		if not sent then
			fail(tostring(reason) .. ". Not hopping.")
			return
		end
	end

	for index, rift in ipairs(riftList) do
		if rift.Parent == rifts then
			local labels = readLabels(rift)
			local embed = buildEmbed(rift, labels, joinUrl)

			local sent, reason = sendDiscord({
				embeds = {embed}
			})

			if not sent then
				fail(
					"Report failed for " .. rift.Name
					.. ": " .. tostring(reason)
					.. ". Not hopping."
				)
				return
			end

			log("Sent " .. index .. "/" .. #riftList .. ": " .. rift.Name)
			task.wait(CONFIG.MessageDelay)
		end
	end

	log("Reports delivered. Waiting before server hop.")
	task.wait(CONFIG.HopDelay)

	local nextServer, reason = findNextServer()
	if not nextServer then
		fail(reason)
		return
	end

	-- Include source, configuration, and visited-server state.
	local nextExecution =
		"local SOURCE = " .. string.format("%q", SOURCE) .. "\n"
		.. "local CONFIG = game:GetService('HttpService'):JSONDecode("
		.. string.format("%q", Http:JSONEncode(CONFIG)) .. ")\n"
		.. "local VISITED = game:GetService('HttpService'):JSONDecode("
		.. string.format("%q", Http:JSONEncode(visited)) .. ")\n"
		.. SOURCE

	local queued, queueError = pcall(function()
		queueTeleport(nextExecution)
	end)

	if not queued then
		fail("Could not queue next execution: " .. tostring(queueError))
		return
	end

	local failureConnection
	failureConnection = Teleport.TeleportInitFailed:Connect(
		function(who, result)
			if who == player then
				failureConnection:Disconnect()
				fail("Teleport failed: " .. tostring(result))
			end
		end
	)

	log("Joining server: " .. nextServer)

	local ok, err = pcall(function()
		Teleport:TeleportToPlaceInstance(
			game.PlaceId,
			nextServer,
			player
		)
	end)

	if not ok then
		failureConnection:Disconnect()
		fail("Teleport request failed: " .. tostring(err))
	end
end

